# Copy this file to .env and fill in real values.
# NEVER commit a real .env file. It is already ignored by .gitignore.

# Use a strong password and a dedicated database user in any non-local environment.
# The example below is ONLY for local development.
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/classroom"

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# GitHub OAuth (optional for local development)
# Create an OAuth App: https://docs.github.com/en/developers/apps/building-oauth-apps/creating-an-oauth-app
# Callback URL for local: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Auth0 (intended for production in the original project)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=https://example-tenant.auth0.com

# Optional shadow database for Prisma migrations
# SHADOW_DATABASE_URL=
